# =============================================================================
# codingAI — Environment Configuration
# =============================================================================
#
# Copy this file to ai-agent/.env and adjust values as needed:
#   cp .env.example ai-agent/.env
#
# Docker Compose also reads variables from the shell environment and from
# ai-agent/.env (via env_file). Shell env > .env file > compose defaults.
# =============================================================================

# -----------------------------------------------------------------------------
# Ports (host-side)
# -----------------------------------------------------------------------------
# CODINGAI_HTTP_PORT=8000
# VAULT_PORT=8200
# OLLAMA_PORT=11434
# SEARXNG_PORT=8080

# -----------------------------------------------------------------------------
# Vault
# -----------------------------------------------------------------------------
# VAULT_ENABLED=false
# VAULT_TOKEN=codingai-dev-token
# VAULT_DEV_LISTEN_ADDRESS=0.0.0.0:8200

# -----------------------------------------------------------------------------
# LLM Provider
# -----------------------------------------------------------------------------
# Provider selection: "openai", "local", or "auto" (tries LLM_PROVIDER_ORDER)
# LLM_PROVIDER=auto
# LLM_PROVIDER_ORDER=local,openai
# LLM_FALLBACK_ENABLED=true

# OpenAI (required when using openai provider)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Local LLM (Ollama)
# LOCAL_LLM_BASE_URL=http://ollama:11434      # Docker-internal (set by compose)
# LOCAL_LLM_MODEL=tinyllama:1.1b              # Model to use + pull via setup service
# LOCAL_LLM_API_MODE=chat                     # "chat" (Ollama-native) or "responses" (OpenAI-compat)
# LOCAL_LLM_TEMPERATURE=0.1

# -----------------------------------------------------------------------------
# Ollama Performance Tuning
# -----------------------------------------------------------------------------
# These are set in docker-compose.yaml with sensible defaults.
# Override here only if needed.
#
# OLLAMA_FLASH_ATTENTION=1       # Faster inference on modern GPUs
# OLLAMA_KEEP_ALIVE=24h          # Keep models loaded (default 5m → 24h)
# OLLAMA_MAX_LOADED_MODELS=2     # Hot-swap between N models in memory
# OLLAMA_NUM_PARALLEL=4          # Concurrent request handling
# OLLAMA_GPU_OVERHEAD=0          # Reserve 0 bytes VRAM for non-Ollama use

# -----------------------------------------------------------------------------
# SearXNG (web search)
# -----------------------------------------------------------------------------
# SEARX_URL=http://searxng:8080              # Docker-internal (set by compose)

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# CODINGAI_DB_FILE=/app/ai-agent/db/state.db  # SQLite path inside container

# -----------------------------------------------------------------------------
# GitHub Integration
# -----------------------------------------------------------------------------
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_WEBHOOK_SECRET=
